<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eaut_student_care_course_list" model="ir.ui.view">
        <field name="name">eaut.student.care.course.list</field>
        <field name="model">eaut.student.care.course</field>
        <field name="arch" type="xml">
            <list string="Môn học">
                <field name="code"/>
                <field name="name"/>
                <field name="credit"/>
            </list>
        </field>
    </record>

    <record id="view_eaut_student_care_course_form" model="ir.ui.view">
        <field name="name">eaut.student.care.course.form</field>
        <field name="model">eaut.student.care.course</field>
        <field name="arch" type="xml">
            <form string="Môn học">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Tên môn học"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="credit"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eaut_student_care_course" model="ir.actions.act_window">
        <field name="name">Môn học</field>
        <field name="res_model">eaut.student.care.course</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
