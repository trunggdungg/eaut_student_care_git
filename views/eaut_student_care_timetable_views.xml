<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eaut_student_care_timetable_list" model="ir.ui.view">
        <field name="name">eaut.student.care.timetable.list</field>
        <field name="model">eaut.student.care.timetable</field>
        <field name="arch" type="xml">
            <list string="Thời khóa biểu" editable="bottom">
                <field name="student_id"/>
                <field name="semester_id"/>
                <field name="course_id"/>
                <field name="weekday"/>
                <field name="time_start" widget="float_time"/>
                <field name="time_end" widget="float_time"/>
                <field name="room"/>
                <field name="teacher"/>
            </list>
        </field>
    </record>

    <record id="view_eaut_student_care_timetable_form" model="ir.ui.view">
        <field name="name">eaut.student.care.timetable.form</field>
        <field name="model">eaut.student.care.timetable</field>
        <field name="arch" type="xml">
            <form string="Thời khóa biểu">
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="semester_id"/>
                            <field name="course_id"/>
                        </group>
                        <group>
                            <field name="weekday"/>
                            <field name="time_start" widget="float_time"/>
                            <field name="time_end" widget="float_time"/>
                            <field name="room"/>
                            <field name="teacher"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eaut_student_care_timetable" model="ir.actions.act_window">
        <field name="name">Thời khóa biểu</field>
        <field name="res_model">eaut.student.care.timetable</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
