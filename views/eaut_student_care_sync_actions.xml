    <record id="action_server_eaut_student_care_demo_data" model="ir.actions.server">
        <field name="name">Tạo dữ liệu mẫu</field>
        <field name="model_id" ref="eaut_base.model_eaut_base_student"/>
        <field name="state">code</field>
        <field name="code">action = model.generate_demo_data()</field>
    </record>

</odoo>
