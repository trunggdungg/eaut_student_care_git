<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_server_eaut_student_care_sync_data" model="ir.actions.server">
        <field name="name">Đồng bộ dữ liệu</field>
        <field name="model_id" ref="eaut_base.model_eaut_base_student"/>
        <field name="binding_model_id" ref="eaut_base.model_eaut_base_student"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_sync_data()</field>
