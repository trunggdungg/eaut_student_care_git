<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eaut_student_care_state_list" model="ir.ui.view">
        <field name="name">eaut.student.care.state.list</field>
        <field name="model">eaut.student.care.state</field>
        <field name="arch" type="xml">
            <list string="Trạng thái">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_eaut_student_care_state_form" model="ir.ui.view">
        <field name="name">eaut.student.care.state.form</field>
        <field name="model">eaut.student.care.state</field>
        <field name="arch" type="xml">
            <form string="Trạng thái">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="VD: Đang học, Bảo lưu, Thôi học..."/></h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="description" placeholder="Mô tả (tuỳ chọn)"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eaut_student_care_state" model="ir.actions.act_window">
        <field name="name">Trạng thái</field>
        <field name="res_model">eaut.student.care.state</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
