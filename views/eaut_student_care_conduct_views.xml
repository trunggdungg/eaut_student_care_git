<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eaut_student_care_conduct_list" model="ir.ui.view">
        <field name="name">eaut.student.care.conduct.list</field>
        <field name="model">eaut.student.care.conduct</field>
        <field name="arch" type="xml">
            <list string="Điểm rèn luyện" editable="bottom">
                <field name="student_id"/>
                <field name="semester_id"/>
                <field name="score"/>
                <field name="classification"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_eaut_student_care_conduct_form" model="ir.ui.view">
        <field name="name">eaut.student.care.conduct.form</field>
        <field name="model">eaut.student.care.conduct</field>
        <field name="arch" type="xml">
            <form string="Điểm rèn luyện">
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="semester_id"/>
                        </group>
                        <group>
                            <field name="score"/>
                            <field name="classification"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eaut_student_care_conduct" model="ir.actions.act_window">
        <field name="name">Điểm rèn luyện</field>
        <field name="res_model">eaut.student.care.conduct</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>