<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eaut_student_care_grade_list" model="ir.ui.view">
        <field name="name">eaut.student.care.grade.list</field>
        <field name="model">eaut.student.care.grade</field>
        <field name="arch" type="xml">
            <list string="Bảng điểm" editable="bottom" decoration-danger="result == 'failed'">
                <field name="student_id"/>
                <field name="semester_id"/>
                <field name="course_id"/>
                <field name="score"/>
                <field name="result"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_eaut_student_care_grade_form" model="ir.ui.view">
        <field name="name">eaut.student.care.grade.form</field>
        <field name="model">eaut.student.care.grade</field>
        <field name="arch" type="xml">
            <form string="Bảng điểm">
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="semester_id"/>
                            <field name="course_id"/>
                        </group>
                        <group>
                            <field name="score"/>
                            <field name="result" readonly="1"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eaut_student_care_grade" model="ir.actions.act_window">
        <field name="name">Bảng điểm</field>
        <field name="res_model">eaut.student.care.grade</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
