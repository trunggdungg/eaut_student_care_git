<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eaut_student_care_classroom_list" model="ir.ui.view">
        <field name="name">eaut.student.care.classroom.list</field>
        <field name="model">eaut.student.care.classroom</field>
        <field name="arch" type="xml">
            <list string="Lớp">
                <field name="name"/>
                <field name="major_id"/>
            </list>
        </field>
    </record>

    <record id="view_eaut_student_care_classroom_form" model="ir.ui.view">
        <field name="name">eaut.student.care.classroom.form</field>
        <field name="model">eaut.student.care.classroom</field>
        <field name="arch" type="xml">
            <form string="Lớp">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="VD: CNTT K12A"/></h1>
                    </div>
                    <group>
                        <field name="major_id"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eaut_student_care_classroom" model="ir.actions.act_window">
        <field name="name">Lớp</field>
        <field name="res_model">eaut.student.care.classroom</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
